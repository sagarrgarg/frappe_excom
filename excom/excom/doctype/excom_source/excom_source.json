{
 "doctype": "DocType",
 "name": "Excom Source",
 "module": "Excom",
 "custom": 0,
 "engine": "InnoDB",
 "editable_grid": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "source_name",
   "fieldtype": "Data",
   "label": "Source Name",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "source_type",
   "fieldtype": "Select",
   "label": "Source Type",
   "options": "Website\nIndiaMART\nTradeIndia\nMeta Lead Ads\nExhibition\nManual\nChannel",
   "reqd": 1,
   "in_list_view": 1,
   "description": "Website / IndiaMART / TradeIndia / Meta = integrations \u00b7 Exhibition / Manual = typed in \u00b7 Channel = organic conversations (WhatsApp, email, web chat) stamped automatically"
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled",
   "default": "1",
   "in_list_view": 1
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "reqd": 1
  },
  {
   "fieldname": "channel_account",
   "fieldtype": "Link",
   "label": "Channel Account",
   "options": "Excom Channel Account",
   "description": "WhatsApp account used for the auto-acknowledgement.",
   "depends_on": "eval:![\"Exhibition\",\"Manual\"].includes(doc.source_type)"
  },
  {
   "fieldname": "cb1",
   "fieldtype": "Column Break",
   "label": "Cb1"
  },
  {
   "fieldname": "mode",
   "fieldtype": "Select",
   "label": "Mode",
   "options": "\nPush\nPull\nBoth",
   "default": "Pull",
   "read_only": 1,
   "description": "Derived from the source type: Website = your site posts to Excom's webhook \u00b7 TradeIndia = Excom polls \u00b7 IndiaMART and Meta = poll (authoritative) + push accelerator.",
   "depends_on": "eval:![\"Exhibition\",\"Manual\"].includes(doc.source_type)"
  },
  {
   "fieldname": "pull_frequency",
   "fieldtype": "Select",
   "label": "Pull Every",
   "options": "Every 5 Minutes\nEvery 15 Minutes\nHourly\nDaily",
   "default": "Every 15 Minutes",
   "depends_on": "eval:[\"IndiaMART\",\"TradeIndia\",\"Meta Lead Ads\"].includes(doc.source_type)"
  },
  {
   "fieldname": "last_synced_at",
   "fieldtype": "Datetime",
   "label": "Last Synced At",
   "read_only": 1,
   "depends_on": "eval:[\"IndiaMART\",\"TradeIndia\",\"Meta Lead Ads\"].includes(doc.source_type)"
  },
  {
   "fieldname": "last_success_at",
   "fieldtype": "Datetime",
   "label": "Last Success At",
   "read_only": 1,
   "depends_on": "eval:[\"IndiaMART\",\"TradeIndia\",\"Meta Lead Ads\"].includes(doc.source_type)"
  },
  {
   "fieldname": "default_lead_owner",
   "fieldtype": "Link",
   "label": "Default Lead Owner",
   "options": "User"
  },
  {
   "fieldname": "sla_first_response",
   "fieldtype": "Duration",
   "label": "Sla First Response",
   "description": "5 min IndiaMART \u00b7 15 min TradeIndia \u00b7 30 min Meta \u00b7 1 h web"
  },
  {
   "fieldname": "auto_ack_template",
   "fieldtype": "Link",
   "label": "Auto Ack Template",
   "options": "WhatsApp Templates",
   "description": "Approved utility template; marketplace sources only",
   "depends_on": "eval:![\"Exhibition\",\"Manual\"].includes(doc.source_type)"
  },
  {
   "fieldname": "default_campaign",
   "fieldtype": "Data",
   "label": "Campaign",
   "description": "Stamped on every lead from this source: Campaign on v15, UTM Campaign on v16. A web form's utm_campaign overrides it.",
   "depends_on": "eval:![\"Channel\"].includes(doc.source_type)"
  },
  {
   "fieldname": "default_medium",
   "fieldtype": "Data",
   "label": "Medium",
   "description": "e.g. paid-social, marketplace, exhibition. UTM Medium on v16; ignored on v15 (no native field).",
   "depends_on": "eval:![\"Channel\"].includes(doc.source_type)"
  },
  {
   "fieldname": "sec_cred",
   "fieldtype": "Section Break",
   "label": "Vendor API (Excom polls)",
   "depends_on": "eval:[\"IndiaMART\",\"TradeIndia\",\"Meta Lead Ads\"].includes(doc.source_type)"
  },
  {
   "fieldname": "api_url",
   "fieldtype": "Data",
   "label": "API URL",
   "description": "TradeIndia: the URL from 'My Inquiry API'.",
   "depends_on": "eval:doc.source_type==\"TradeIndia\""
  },
  {
   "fieldname": "api_key",
   "fieldtype": "Password",
   "label": "API Key",
   "depends_on": "eval:[\"IndiaMART\",\"TradeIndia\"].includes(doc.source_type)",
   "description": "IndiaMART: CRM key \u00b7 TradeIndia: key."
  },
  {
   "fieldname": "api_secret",
   "fieldtype": "Password",
   "label": "API Secret",
   "depends_on": "eval:doc.source_type==\"TradeIndia\""
  },
  {
   "fieldname": "cb2",
   "fieldtype": "Column Break",
   "label": "Cb2"
  },
  {
   "fieldname": "user_id",
   "fieldtype": "Data",
   "label": "User ID",
   "depends_on": "eval:doc.source_type==\"TradeIndia\""
  },
  {
   "fieldname": "profile_id",
   "fieldtype": "Data",
   "label": "Profile ID",
   "depends_on": "eval:doc.source_type==\"TradeIndia\""
  },
  {
   "fieldname": "access_token",
   "fieldtype": "Password",
   "label": "Page Access Token",
   "description": "Set automatically when enabled from Meta Business.",
   "depends_on": "eval:doc.source_type==\"Meta Lead Ads\""
  },
  {
   "fieldname": "page_id",
   "fieldtype": "Data",
   "label": "Page ID",
   "description": "Meta Page id",
   "depends_on": "eval:doc.source_type==\"Meta Lead Ads\""
  },
  {
   "fieldname": "form_id",
   "fieldtype": "Data",
   "label": "Form ID",
   "description": "Meta lead form id (reconciliation poll)",
   "depends_on": "eval:doc.source_type==\"Meta Lead Ads\""
  },
  {
   "fieldname": "sec_push",
   "fieldtype": "Section Break",
   "label": "Incoming webhook (they post to Excom)",
   "depends_on": "eval:[\"Website\",\"IndiaMART\"].includes(doc.source_type)"
  },
  {
   "fieldname": "push_token",
   "fieldtype": "Password",
   "label": "Push Token",
   "description": "Generate from the embed panel below; goes in the form / webhook URL.",
   "depends_on": "eval:[\"Website\",\"IndiaMART\"].includes(doc.source_type)"
  },
  {
   "fieldname": "allowed_origins",
   "fieldtype": "Small Text",
   "label": "Allowed Origins",
   "description": "One per line, e.g. https://www.yoursite.com \u2014 required for browser forms.",
   "depends_on": "eval:doc.source_type==\"Website\""
  },
  {
   "fieldname": "cb3",
   "fieldtype": "Column Break",
   "label": "Cb3"
  },
  {
   "fieldname": "allowed_ips",
   "fieldtype": "Small Text",
   "label": "Allowed IPs",
   "description": "Optional CIDR list for server-to-server callers (IndiaMART push, form builders).",
   "depends_on": "eval:[\"Website\",\"IndiaMART\"].includes(doc.source_type)"
  },
  {
   "fieldname": "captcha_secret",
   "fieldtype": "Password",
   "label": "Captcha Secret",
   "description": "Turnstile / hCaptcha secret; leave empty to skip.",
   "depends_on": "eval:doc.source_type==\"Website\""
  },
  {
   "fieldname": "min_fill_seconds",
   "fieldtype": "Int",
   "label": "Min Fill Seconds",
   "default": "3",
   "depends_on": "eval:doc.source_type==\"Website\"",
   "description": "Submissions faster than this are dropped as bots."
  },
  {
   "fieldname": "sec_map",
   "fieldtype": "Section Break",
   "label": "Field map (vendor key \u2192 lead field)"
  },
  {
   "fieldname": "field_map",
   "fieldtype": "Table",
   "label": "Field Map",
   "options": "Excom Source Field Map"
  },
  {
   "fieldname": "visibility_section",
   "fieldtype": "Section Break",
   "label": "Team Visibility"
  },
  {
   "fieldname": "allowed_teams",
   "fieldtype": "Table",
   "label": "Allowed Teams",
   "options": "Excom Account Team",
   "description": "Unassigned leads from this source are visible to managers of these teams (all managers when empty). Once assigned, the owner sees them too. Members see only leads assigned to them."
  }
 ],
 "field_order": [
