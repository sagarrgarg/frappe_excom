   "default": "0",
   "description": "Master switch. Off: no scheduled work, no AI calls, no queue entries for any agent."
  },
  {
   "fieldname": "default_model",
   "fieldtype": "Data",
   "label": "Default Model",
   "default": "claude-opus-5-5",
