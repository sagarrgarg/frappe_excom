# Required
# https only (the key travels on every request); ALLOW_INSECURE_FRAPPE=1 allows http for local dev.
FRAPPE_URL=https://erp.example.com
# The same value as Excom AI Settings > Voice Service Key; at least 32 characters
# (e.g. openssl rand -hex 24).
VOICE_KEY=change-me-same-value-as-on-the-frappe-side-32chars-min
DEEPGRAM_API_KEY=

# Listening address: loopback, with TLS in front (deploy/Caddyfile; Twilio and Plivo need wss://)
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

# Optional tuning (defaults shown)
# STT_PROVIDER=deepgram          # or "fake" for dry runs
# TTS_PROVIDER=deepgram          # or "fake"
# DEEPGRAM_STT_MODEL=nova-3
# DEEPGRAM_ENDPOINTING_MS=500
# DEEPGRAM_UTTERANCE_END_MS=1000
# BARGE_IN_ON=speech_started     # or "words": interrupt only on recognised words
# FRAPPE_TIMEOUT_SECONDS=10
# END_RETRY_SECONDS=120          # how long voice.end is retried (in the background)
# DEFAULT_MAX_SECONDS=600        # used when voice.start sends no max_seconds (Frappe's default too)
# DEFAULT_TURN_LIMIT=30          # used when voice.start sends no turn_limit
# IDLE_TIMEOUT_SECONDS=20        # silence before "are you still there?", then goodbye; 0 = off
# PRE_STT_BUFFER_SECONDS=2       # caller audio kept until speech-to-text connects
# MAX_CALLS=20                   # concurrent streams; more are refused at the handshake (no TTS spent)
# CONNECTS_PER_IP_PER_MINUTE=60  # per client address; 0 = off
# TRUSTED_PROXIES=127.0.0.1,::1  # peers whose X-Forwarded-For is believed (the TLS proxy)
# ALLOW_INSECURE_FRAPPE=0
